# Wrangler 로컬 캐시/상태 (자동 생성, 계정 정보 포함)
.wrangler/

# OS / 에디터
.DS_Store
Thumbs.db

# Excel 임시 잠금 파일
~$*

.dev.vars*
!.dev.vars.example
.env*
!.env.example

# ─────────────────────────────────────────────────────────────
# 교사용 임베딩 HTML — 외부 i-App 서비스에 임베딩해서 사용 (이 저장소에서 배포 안 함)
# Airtable Personal Access Token이 하드코딩되어 있어 GitHub push protection이
# 푸시를 차단함 → Git 추적 제외. (배포 불필요 + 토큰 노출 방지)
# 백업이 필요하면 토큰을 제거한 뒤 별도 비공개 위치에 보관할 것.
# ─────────────────────────────────────────────────────────────
flashcard/*teacher*.html

# 단어 이미지 업로드 — 로컬 전용 (상태·API키 설정·실행 배치)
scripts/.word-images.state.json
scripts/.word-images.config.json
단어이미지-자동배포.bat

# Codex 설정 — 로컬 전용 (나중에 사용 예정)
.codex/
